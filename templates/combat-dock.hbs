<div class="ds-combat-dock">

  <div class="ds-dock-content">

  {{!-- Party Side (Left) --}}
  <div class="ds-dock-side ds-dock-party {{#if partyHighlighted}}highlighted{{/if}}">
    {{#each partyEntries}}
    {{#if isGroup}}
    <div class="ds-group-wrapper">
      <div class="ds-group-container {{cssClass}}" data-id="{{id}}" data-type="group" {{#if pillColor}}style="background-color: {{pillColor}}26;"{{/if}}>
        {{#if captainData}}
        <div class="ds-mini-portrait captain {{#if captainData.active}}active{{/if}} {{#if captainData.canAct}}can-act{{/if}} {{#if captainData.defeated}}defeated{{/if}}" data-member-id="{{captainData.id}}" data-type="combatant">
          <div class="ds-mini-portrait-img">
            <img src="{{captainData.img}}" alt="{{captainData.name}}" loading="lazy">
            {{#if captainData.defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
          </div>
        </div>
        {{/if}}
        {{#each nonMinionMembers}}
        <div class="ds-mini-portrait captain {{#if active}}active{{/if}} {{#if canAct}}can-act{{/if}} {{#if defeated}}defeated{{/if}}" data-member-id="{{id}}" data-type="combatant">
          <div class="ds-mini-portrait-img">
            <img src="{{img}}" alt="{{name}}" loading="lazy">
            {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
          </div>
        </div>
        {{/each}}
        {{#each minionGroups}}
        <div class="ds-minion-grid">
          {{#each this}}
          <div class="ds-mini-portrait minion {{#if active}}active{{/if}} {{#if canAct}}can-act{{/if}} {{#if defeated}}defeated{{/if}}" data-member-id="{{id}}" data-type="combatant">
            <div class="ds-mini-portrait-img">
              <img src="{{img}}" alt="{{name}}" loading="lazy">
              {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
      <span class="ds-group-name">{{name}}</span>
      <div class="ds-entry-footer">
        {{#if @root.isGM}}
        <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="group" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
          <i class="fa-solid fa-eye-slash"></i>
        </button>
        {{/if}}
        {{#if staminaText}}<span class="ds-group-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
      </div>
    </div>
    {{else}}
    {{#if retainerData}}
    <div class="ds-mentor-pair {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
      <div class="ds-retainer-portrait {{retainerData.cssClass}}" data-member-id="{{retainerData.id}}" data-type="combatant">
        <div class="ds-retainer-portrait-img">
          <img src="{{retainerData.img}}" alt="{{retainerData.name}}" loading="lazy">
          {{#if retainerData.defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
        </div>
        <span class="ds-portrait-name">{{retainerData.name}}</span>
        <div class="ds-entry-footer">
          {{#if @root.isGM}}
          <button type="button" class="ds-visibility-toggle {{#if retainerData.hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="combatant" data-id="{{retainerData.id}}" data-tooltip="{{retainerData.visibilityTooltip}}" title="{{retainerData.visibilityTooltip}}">
            <i class="fa-solid fa-eye-slash"></i>
          </button>
          {{/if}}
          {{#if retainerData.staminaText}}<span class="ds-portrait-stamina {{retainerData.staminaClass}}">{{retainerData.staminaText}}</span>{{/if}}
        </div>
      </div>
      <div class="ds-portrait {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
        <div class="ds-portrait-img">
          <img src="{{img}}" alt="{{name}}" loading="lazy">
          {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
        </div>
        <span class="ds-portrait-name">{{name}}</span>
        <div class="ds-entry-footer">
          {{#if @root.isGM}}
          <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="{{type}}" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
            <i class="fa-solid fa-eye-slash"></i>
          </button>
          {{/if}}
          {{#if staminaText}}<span class="ds-portrait-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
        </div>
      </div>
    </div>
    {{else}}
    <div class="ds-portrait {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
      <div class="ds-portrait-img">
        <img src="{{img}}" alt="{{name}}" loading="lazy">
        {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
      </div>
      <span class="ds-portrait-name">{{name}}</span>
      <div class="ds-entry-footer">
        {{#if @root.isGM}}
        <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="{{type}}" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
          <i class="fa-solid fa-eye-slash"></i>
        </button>
        {{/if}}
        {{#if staminaText}}<span class="ds-portrait-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}
    {{/each}}
  </div>

  {{!-- Center Info Panel --}}
  <div class="ds-dock-center">
    <button class="ds-dock-toggle ds-dock-hide" title="Hide Combat Dock">
      <i class="fas fa-chevron-up"></i>
    </button>
    {{#if isGM}}
    <button class="ds-dock-close" data-action="closeCombat" data-tooltip="{{localize 'COMBAT.End'}}">
      <i class="fas fa-times"></i>
    </button>
    <div class="ds-dock-menu-wrapper">
      <button type="button" class="ds-dock-menu-toggle" data-action="toggleActionsMenu" title="{{localize 'draw-steel-combat-tracker.ActionsMenu'}}">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
    <div class="ds-dock-menu">
      <button type="button" data-action="toggleNpcVisibility">
        <i class="fa-solid fa-eye-slash"></i>
        <span>{{localize "draw-steel-combat-tracker.ToggleVisibilityForNPCs"}}</span>
      </button>
      <button type="button" data-action="clearMovementHistories">
        <i class="fa-solid fa-shoe-prints"></i>
        <span>{{localize "COMBAT.ClearMovementHistories"}}</span>
      </button>
      <button type="button" data-action="groupSelectedTokens">
        <i class="fa-solid fa-users-viewfinder"></i>
        <span>{{localize "DRAW_STEEL.CombatantGroup.GroupSelected"}}</span>
      </button>
    </div>
    {{/if}}

    <div class="ds-dock-round">
      {{#if isGM}}
      <button class="ds-round-btn" data-action="prevRound" data-tooltip="{{localize 'COMBAT.RoundPrev'}}">
        <i class="fas fa-chevron-left"></i>
      </button>
      {{/if}}
      <span class="ds-round-number">{{localize "draw-steel-combat-tracker.Round"}} {{round}}</span>
      {{#if isGM}}
      <button class="ds-round-btn" data-action="nextRound" data-tooltip="{{localize 'COMBAT.RoundNext'}}">
        <i class="fas fa-chevron-right"></i>
      </button>
      {{/if}}
    </div>

    {{#if turnLabel}}
    <div class="ds-dock-turn">{{turnLabel}}</div>
    {{/if}}

    <div class="ds-dock-actions">
      <button class="ds-dock-btn ds-end-turn" data-action="endTurn" {{#unless canEndTurn}}disabled{{/unless}}>
        {{localize "draw-steel-combat-tracker.EndTurn"}}
      </button>
      {{#if allActed}}
      {{#if isGM}}
      <button class="ds-dock-btn ds-next-round" data-action="nextRound">
        {{localize "draw-steel-combat-tracker.NextRound"}}
      </button>
      {{/if}}
      {{/if}}
    </div>
  </div>

  {{!-- Enemy Side (Right) --}}
  <div class="ds-dock-side ds-dock-enemies {{#if enemyHighlighted}}highlighted{{/if}}">
    {{#each enemyEntries}}
    {{#if isGroup}}
    <div class="ds-group-wrapper">
      <div class="ds-group-container {{cssClass}}" data-id="{{id}}" data-type="group" {{#if pillColor}}style="background-color: {{pillColor}}26;"{{/if}}>
        {{#if captainData}}
        <div class="ds-mini-portrait captain {{#if captainData.active}}active{{/if}} {{#if captainData.canAct}}can-act{{/if}} {{#if captainData.defeated}}defeated{{/if}}" data-member-id="{{captainData.id}}" data-type="combatant">
          <div class="ds-mini-portrait-img">
            <img src="{{captainData.img}}" alt="{{captainData.name}}" loading="lazy">
            {{#if captainData.defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
          </div>
        </div>
        {{/if}}
        {{#each nonMinionMembers}}
        <div class="ds-mini-portrait captain {{#if active}}active{{/if}} {{#if canAct}}can-act{{/if}} {{#if defeated}}defeated{{/if}}" data-member-id="{{id}}" data-type="combatant">
          <div class="ds-mini-portrait-img">
            <img src="{{img}}" alt="{{name}}" loading="lazy">
            {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
          </div>
        </div>
        {{/each}}
        {{#each minionGroups}}
        <div class="ds-minion-grid">
          {{#each this}}
          <div class="ds-mini-portrait minion {{#if active}}active{{/if}} {{#if canAct}}can-act{{/if}} {{#if defeated}}defeated{{/if}}" data-member-id="{{id}}" data-type="combatant">
            <div class="ds-mini-portrait-img">
              <img src="{{img}}" alt="{{name}}" loading="lazy">
              {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
      <span class="ds-group-name">{{name}}</span>
      <div class="ds-entry-footer">
        {{#if @root.isGM}}
        <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="group" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
          <i class="fa-solid fa-eye-slash"></i>
        </button>
        {{/if}}
        {{#if staminaText}}<span class="ds-group-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
      </div>
    </div>
    {{else}}
    {{#if retainerData}}
    <div class="ds-mentor-pair {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
      <div class="ds-retainer-portrait {{retainerData.cssClass}}" data-member-id="{{retainerData.id}}" data-type="combatant">
        <div class="ds-retainer-portrait-img">
          <img src="{{retainerData.img}}" alt="{{retainerData.name}}" loading="lazy">
          {{#if retainerData.defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
        </div>
        <span class="ds-portrait-name">{{retainerData.name}}</span>
        <div class="ds-entry-footer">
          {{#if @root.isGM}}
          <button type="button" class="ds-visibility-toggle {{#if retainerData.hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="combatant" data-id="{{retainerData.id}}" data-tooltip="{{retainerData.visibilityTooltip}}" title="{{retainerData.visibilityTooltip}}">
            <i class="fa-solid fa-eye-slash"></i>
          </button>
          {{/if}}
          {{#if retainerData.staminaText}}<span class="ds-portrait-stamina {{retainerData.staminaClass}}">{{retainerData.staminaText}}</span>{{/if}}
        </div>
      </div>
      <div class="ds-portrait {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
        <div class="ds-portrait-img">
          <img src="{{img}}" alt="{{name}}" loading="lazy">
          {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
        </div>
        <span class="ds-portrait-name">{{name}}</span>
        <div class="ds-entry-footer">
          {{#if @root.isGM}}
          <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="{{type}}" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
            <i class="fa-solid fa-eye-slash"></i>
          </button>
          {{/if}}
          {{#if staminaText}}<span class="ds-portrait-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
        </div>
      </div>
    </div>
    {{else}}
    <div class="ds-portrait {{cssClass}}" data-id="{{id}}" data-type="{{type}}">
      <div class="ds-portrait-img">
        <img src="{{img}}" alt="{{name}}" loading="lazy">
        {{#if defeated}}<i class="fas fa-skull ds-defeated-skull"></i>{{/if}}
      </div>
      <span class="ds-portrait-name">{{name}}</span>
      <div class="ds-entry-footer">
        {{#if @root.isGM}}
        <button type="button" class="ds-visibility-toggle {{#if hidden}}ds-visibility-hidden{{/if}}" data-action="toggleVisibility" data-type="{{type}}" data-id="{{id}}" data-tooltip="{{visibilityTooltip}}" title="{{visibilityTooltip}}">
          <i class="fa-solid fa-eye-slash"></i>
        </button>
        {{/if}}
        {{#if staminaText}}<span class="ds-portrait-stamina {{staminaClass}}">{{staminaText}}</span>{{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}
    {{/each}}
  </div>

  </div>{{!-- .ds-dock-content --}}

  <button class="ds-dock-toggle ds-dock-show" title="Show Combat Dock">
    <i class="fas fa-chevron-down"></i>
  </button>
</div>
